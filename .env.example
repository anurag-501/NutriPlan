# Backend-only configuration. Copy this to .env; never commit private values.
# Local inference is the default; no paid AI credential is required.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_THINK=false
OLLAMA_MAX_OUTPUT_TOKENS=512
OLLAMA_CONTEXT_LENGTH=8192
AI_MAX_OUTPUT_TOKENS=1400
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=35
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=1400
CHAT_RATE_LIMIT_PER_MINUTE=12
# Required only for project/client administration on the versioned API.
# Generate a random value and keep it private. Never use it in frontend code.
API_ADMIN_TOKEN=
API_PLATFORM_RATE_LIMIT_PER_MINUTE=30
# Optional path; defaults to FastAPI_Backend/data/api_platform.sqlite3.
NUTRIPLAN_DB_PATH=
# Comma-separated exact origins for a deployed frontend; blank keeps local dev defaults.
# Do not use a wildcard origin.
CORS_ORIGINS=
