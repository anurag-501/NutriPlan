# Server-side only. Create a private .env from this example and never commit secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=35
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=1400
CHAT_RATE_LIMIT_PER_MINUTE=12
# Comma-separated exact origins for a deployed frontend; blank keeps local dev defaults.
# Do not use a wildcard origin.
CORS_ORIGINS=
